# ConstellaSim environment template — copy to `.env` and fill in locally.
# NEVER commit a real `.env` file.

# Session / cookie signing (required for shared/production deploys)
# CONSTELLASIM_SECRET_KEY=
# FLASK_SECRET_KEY=

# Optional API gate for shared hosts
# REQUIRE_API_KEY=false
# CONSTELLASIM_API_KEY=

# Server
PORT=5001
# HOST=0.0.0.0

# AI provider (leave unset to use offline Demo AI)
NETWORK_AI_PROVIDER=google
# GOOGLE_API_KEY=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_DEPLOYMENT_NAME=gpt-4-turbo
# AWS_REGION=us-east-1

# CORS / security
# CORS_ALLOW_ALL=false
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo observer fallback
# DEMO_LAT=34.1675
# DEMO_LON=-118.5504
# DEMO_LABEL=Tarzana, CA
ANOMALY_MONITOR=true
