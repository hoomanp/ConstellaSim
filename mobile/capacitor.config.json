{
  "appId": "com.constellasim.app",
  "appName": "ConstellaSim",
  "webDir": "www",
  "server": {
    "cleartext": true,
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#05080f"
    }
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile",
    "scheme": "ConstellaSim"
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#05080f"
  }
}
